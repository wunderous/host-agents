# Seeded only during the direct Ubuntu bootstrap exception. All subsequent
# virtualization changes are dispatched through host-agent MCP.
opute ALL=(root) NOPASSWD: /usr/bin/apt-get, /usr/bin/dpkg, /usr/bin/systemctl, /usr/bin/install, /usr/bin/tee, /usr/sbin/usermod, /usr/sbin/modprobe, /usr/bin/snap, /usr/bin/incus
