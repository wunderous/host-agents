{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opute.capability.network-overlay.v1",
  "type": "object",
  "required": ["contractVersion", "ready", "provider", "targetUri"],
  "properties": {
    "contractVersion": {"const": "opute.capability.network-overlay.v1"},
    "ready": {"type": "boolean"},
    "provider": {"type": "string"},
    "targetUri": {"type": "string", "pattern": "^(vm|container):[a-z][a-z0-9-]{0,31}:.+$"},
    "membershipRef": {"type": "string"},
    "nodeId": {"type": "string"},
    "nodeName": {"type": "string"},
    "meshIp": {"type": "string", "format": "ipv4"},
    "meshInterface": {"type": "string"},
    "peerMeshIp": {"type": "string", "format": "ipv4"},
    "nodeCount": {"type": "integer", "minimum": 0},
    "probe": {"type": "object"},
    "deleted": {"type": "boolean"},
    "error": {"type": "string"},
    "pathClass": {"type": "string", "enum": ["private-mesh", "public-ingress"]},
    "stable": {"type": "boolean"},
    "overlayUri": {"type": "string"},
    "generation": {"type": "string"},
    "datastoreMode": {"type": "string", "enum": ["external-datastore", "embedded-etcd-two-node"]},
    "availabilityClass": {"type": "string"},
    "recoveryPolicy": {"type": "string"},
    "endpoint": {"type": "string"}
  }
}
