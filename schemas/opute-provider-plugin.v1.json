{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opute-provider-plugin.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pluginId", "version", "capabilities", "server"],
  "properties": {
    "schema": {"const": "opute-provider-plugin.v1"},
    "pluginId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "version": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1},
    "requires": {"type": "array"},
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "endpoint"],
      "properties": {
        "transport": {"const": "streamable_http"},
        "endpoint": {"type": "string", "pattern": "^https?://"},
        "executable": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "sha256": {"type": "string"}
      }
    }
  }
}
