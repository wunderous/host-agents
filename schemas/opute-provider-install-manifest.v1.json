{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opute-provider-install-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "provides", "hostAgent", "recipes", "validation"],
  "properties": {
    "schema": {"const": "opute-provider-install-manifest.v1"},
    "provider": {"type": "object", "required": ["id", "version"]},
    "provides": {"type": "array", "minItems": 1},
    "requires": {"type": "array"},
    "hostAgent": {"type": "object"},
    "recipes": {"type": "array"},
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "operations"],
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array"},
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "inputSchema", "outputSchema", "effect", "idempotent", "supportsReadiness"],
              "properties": {
                "id": {"type": "string"},
                "inputSchema": {"type": "object"},
                "outputSchema": {"type": "object"},
                "effect": {"enum": ["read", "mutation", "destructive", "credential_bearing"]},
                "resourceKinds": {"type": "array", "items": {"type": "string"}},
                "idempotent": {"type": "boolean"},
                "supportsReadiness": {"type": "boolean"},
                "supportsStreaming": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "validation": {"type": "object", "required": ["capability", "operation"]}
  }
}
