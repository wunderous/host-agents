{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opute.capability.mesh-membership.v1",
  "type": "object",
  "required": [
    "contractVersion",
    "ready",
    "provider",
    "targetUri"
  ],
  "properties": {
    "contractVersion": {
      "const": "opute.capability.mesh-membership.v1"
    },
    "ready": {
      "type": "boolean"
    },
    "provider": {
      "type": "string"
    },
    "targetUri": {
      "type": "string",
      "pattern": "^(vm|container):[a-z][a-z0-9-]{0,31}:.+$"
    },
    "membershipRef": {
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "nodeName": {
      "type": "string"
    },
    "meshIp": {
      "type": "string",
      "format": "ipv4"
    },
    "meshInterface": {
      "type": "string"
    },
    "peerMeshIp": {
      "type": "string",
      "format": "ipv4"
    },
    "probe": {
      "type": "object"
    },
    "deleted": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "overlayUri": {
      "type": "string"
    },
    "generation": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "stable": {
      "type": "boolean"
    },
    "publicURL": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    }
  }
}
