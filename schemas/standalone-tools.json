{
  "schemaVersion": "1.0",
  "serverName": "host-agent",
  "provider": "incus",
  "transport": "http",
  "supportedPlatforms": [
    "linux/amd64",
    "linux/arm64",
    "windows-client/wsl"
  ],
  "smoke": {
    "requiredTools": [
      "check_local_prerequisites",
      "get_local_status",
      "list_vms",
      "create_vm",
      "get_operation"
    ],
    "forbiddenTools": [
      "register_host_agent",
      "host_agent_heartbeat",
      "dispatch_host_operation",
      "agent_shell"
    ]
  },
  "tools": [
    {
      "name": "run_host_command",
      "classification": "mutation",
      "support": "experimental",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7200000
          }
        },
        "required": [
          "command"
        ]
      }
    },
    {
      "name": "request_task_input",
      "classification": "read_only",
      "support": "experimental",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "responseType": {
            "type": "string",
            "enum": [
              "string",
              "boolean"
            ]
          }
        },
        "required": [
          "prompt"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "response"
        ]
      }
    },
    {
      "name": "probe_openai_compatible_server",
      "classification": "read_only",
      "support": "experimental"
    },
    {
      "name": "probe_http_endpoint",
      "classification": "read_only",
      "support": "experimental"
    },
